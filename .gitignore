# ==========================================
# 1. Node.js Ecosystem Rules
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env

# ==========================================
# 2. Deep Terraform Ecosystem Rules
# ==========================================
# This blocks local terraform states anywhere inside subfolders
**/.terraform/
**/*.tfstate
**/*.tfstate.backup
**/.terraform.lock.hcl

# Ignore variable secret files
**/*.tfvars
**/*.tfvars.json
